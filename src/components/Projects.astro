---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

const featured = projects.filter((p: any) => p.featured);
const rest = projects.filter((p: any) => !p.featured);
---

<section id="projects" class="py-16 sm:py-24 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">
      Proyectos
    </p>
    <h2
      class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-balance text-fg mb-3 sm:mb-4"
    >
      Trabajo destacado
    </h2>
    <p class="text-muted mb-8 sm:mb-12 text-sm sm:text-[15px] max-w-2xl text-pretty">
      {featured.length} casos seleccionados. Cada uno con su problema, solución y
      resultado.
    </p>

    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-stretch"
    >
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>

    {
      rest.length > 0 && (
        <details class="group mt-6">
          <summary class="flex cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium text-muted hover:text-fg bg-fg/[.03] hover:bg-fg/[.06] border border-line/[.12] rounded-lg transition-all duration-200">
            <ion-icon name="chevron-down-outline" class="text-base transition-transform duration-200 group-open:rotate-180" />
            <span class="group-open:hidden">Ver {rest.length} proyectos más</span>
            <span class="hidden group-open:inline">Ver menos</span>
          </summary>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-stretch mt-6">
            {rest.map((project) => (
              <ProjectCard project={project} animate={false} />
            ))}
          </div>
        </details>
      )
    }

    <!-- GitHub CTA -->
    <div class="mt-7 sm:mt-8 text-center">
      <a
        href="https://github.com/millerbermeo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-muted hover:text-fg bg-fg/[.03] hover:bg-fg/[.06] border border-line/[.12] rounded-lg transition-all duration-200"
      >
        <ion-icon name="logo-github" class="text-base"></ion-icon>
        Ver más en GitHub
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-thumb]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest("[data-project-card]");
      const mainImage = card?.querySelector<HTMLImageElement>("[data-main-image]");
      const src = btn.dataset.thumb;
      if (!mainImage || !src) return;

      mainImage.style.opacity = "0";
      window.setTimeout(() => {
        mainImage.src = src;
        mainImage.style.opacity = "";
      }, 150);

      card?.querySelectorAll("[data-thumb]").forEach((t) => {
        t.classList.remove("border-accent", "ring-1", "ring-accent");
        t.classList.add("border-line/10");
      });
      btn.classList.remove("border-line/10");
      btn.classList.add("border-accent", "ring-1", "ring-accent");
    });
  });
</script>
